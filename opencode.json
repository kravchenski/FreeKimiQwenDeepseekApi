{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-clipboard-image"],
  "model": "freeqwen/deepseek-default",
  "small_model": "freeqwen/glm-5.2-free",
  "disabled_providers": ["anthropic", "openai", "google", "azure", "aws", "github"],
  "provider": {
    "freeqwen": {
      "name": "FreeQwen API",
      "api": "opencode",
      "env": ["OPENCODE_API_KEY"],
      "options": {
        "baseURL": "http://localhost:3260/v1",
        "apiKey": ""
      },
      "models": {
        "deepseek-default": { "name": "DeepSeek Default", "family": "deepseek", "tool_call": true, "cost": { "input": 0, "output": 0 } },
        "deepseek-expert": { "name": "DeepSeek Expert", "family": "deepseek", "tool_call": true, "cost": { "input": 0, "output": 0 } },
        "deepseek-search": { "name": "DeepSeek Search", "family": "deepseek", "tool_call": true, "cost": { "input": 0, "output": 0 } },
        "kimi-k2.7-code-free": { "name": "Kimi K2.7 Code Free", "family": "kimi", "tool_call": true, "cost": { "input": 0, "output": 0 } },
        "glm-5.2-free": { "name": "GLM 5.2 Free", "family": "glm", "tool_call": true, "cost": { "input": 0, "output": 0 } },
        "glm-4.7-flash-free": { "name": "GLM 4.7 Flash Free", "family": "glm", "tool_call": true, "cost": { "input": 0, "output": 0 } },
        "sapiens-ai/agnes-2.0-flash": { "name": "Sapiens Agnes 2.0 Flash", "family": "sapiens", "tool_call": true, "cost": { "input": 0, "output": 0 } },
        "stepfun/step-3.7-flash-free": { "name": "StepFun Step 3.7 Flash Free", "family": "stepfun", "tool_call": true, "cost": { "input": 0, "output": 0 } },
        "deepseek-ai/deepseek-v4-pro": { "name": "DeepSeek V4 Pro (NVIDIA)", "family": "nvidia", "tool_call": true, "cost": { "input": 0, "output": 0 } },
        "moonshotai/kimi-k2.6": { "name": "Kimi K2.6 (NVIDIA)", "family": "nvidia", "tool_call": true, "cost": { "input": 0, "output": 0 } }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--browser", "firefox"],
      "enabled": true
    }
  }
}
