# Required for GLM/Kimi/Sapiens/StepFun (via ZenMux).
# Get your key at https://zenmux.ai
ZENMUX_API_KEY=

# Optional: NVIDIA API for DeepSeek V4 Pro and Kimi K2.6.
# Get your key at https://build.nvidia.com
NVIDIA_API_KEY=

# Host ports. Compose binds them to 127.0.0.1 by default.
GATEWAY_PORT=3263
PORT=3264

# Optional bearer token for the unified API (3260) and gateway (3263).
# Strongly recommended if the port is reachable beyond localhost.
GATEWAY_API_KEY=

# Qwen models go through an OpenAI-compatible Qwen API proxy (https://qwen-api.readme.io).
# The token is your chat.qwen.ai access token (JWT) and grants full access to that account;
# it is sent to QWEN_API_BASE_URL, so only point this at a proxy you trust or host yourself.
# If QWEN_TOKEN is empty, tokens saved via `bun run auth` are used.
QWEN_API_BASE_URL=https://qwen.aikit.club/v1
QWEN_TOKEN=
