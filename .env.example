# Optional API fallback providers with free tiers. Leave a key empty to skip the provider,
# or save it encrypted instead: bun run account add <provider> --api-key
# Keys: build.nvidia.com, openrouter.ai/keys (only :free models are used), console.groq.com/keys,
# aistudio.google.com/apikey, cloud.cerebras.ai, console.mistral.ai/api-keys, cloud.sambanova.ai/apis
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
SAMBANOVA_API_KEY=

# Host ports. Compose binds them to 127.0.0.1 by default.
UNIFIED_PORT=3260

# Optional bearer token for the unified API and gateway.
GATEWAY_API_KEY=

# Encrypts the credential registry session/credentials.enc.
# Leave empty: `bun run account init` keeps it in the system keyring instead of this file.
# Set it only where no keyring exists (Docker, CI).
ACCOUNTS_SECRET=

# Fallback order for model=auto (comma-separated). Empty = built automatically:
# web chats first, then discovered NVIDIA models, fastest measured first.
AUTO_MODELS=
# Skip an auto route that sends nothing within this time (0 disables).
AUTO_FIRST_CHUNK_TIMEOUT_MS=60000
# How often provider model lists are refreshed (0 disables).
MODEL_REFRESH_MINUTES=360
