# Required for GLM/Kimi/Sapiens/StepFun (via ZenMux).
# Get your key at https://zenmux.ai
ZENMUX_API_KEY=

# Optional: NVIDIA API for DeepSeek V4 Pro and Kimi K2.6.
# Get your key at https://build.nvidia.com
NVIDIA_API_KEY=

# Host ports. Compose binds them to 127.0.0.1 by default.
GATEWAY_PORT=3263
PORT=3264

# Optional bearer token for the unified API and gateway.
GATEWAY_API_KEY=

# Qwen API proxy; QWEN_TOKEN is your chat.qwen.ai token (falls back to `bun run auth` accounts).
QWEN_API_BASE_URL=https://qwen.aikit.club/v1
QWEN_TOKEN=

# Encrypts saved account credentials (min 16 chars, e.g. openssl rand -base64 32).
ACCOUNTS_SECRET=
